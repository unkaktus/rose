import site
import sys
import os
import subprocess

python_path = ":".join(site.getsitepackages())

env = os.environ.copy()
env["ROSE_CACHE_DIR"] = os.path.join("os.getcwd()", "rose-cache")
env["PYTHONPATH"] = python_path
env["PV_PLUGIN_PATH"] = os.path.join("os.getcwd()", "plugins")

pv_path = sys.argv[1]
pvpython_path = "pvpython"

if pv_path.endswith(".app"):
   pvpython_path = os.path.join(pv_path, "Contents/bin/pvpython")

subprocess.run([pvpython_path]+sys.argv[2:], stdout=sys.stdout, stderr=sys.stderr, env=env)
